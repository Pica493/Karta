/* ================================================================
   УТИЛИТЫ
   ================================================================ */
function measureCssVar(name, fallback){
  try {
    const probe = document.createElement('div');
    probe.style.cssText = 'position:absolute;visibility:hidden;pointer-events:none;width:' + name + ';height:0;';
    document.body.appendChild(probe);
    const w = probe.getBoundingClientRect().width;
    probe.remove();
    return w > 0 ? w : fallback;
  } catch(e) { return fallback; }
}
function getOverlaps(){
  const cardW = measureCssVar('--card-w', 80);
  const cardH = measureCssVar('--card-h', 112);
  const portrait = window.innerHeight > window.innerWidth;
  return {
    up: Math.round(cardH * (portrait ? 0.22 : 0.25)),
    down: Math.round(cardH * (portrait ? 0.12 : 0.11)),
    waste: Math.round(cardW * (portrait ? 0.30 : 0.22))
  };
}
function formatTime(s){
  const m = Math.floor(s / 60);
  const sec = s % 60;
  return `${m}:${sec.toString().padStart(2,'0')}`;
}

