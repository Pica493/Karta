const PlayerData = (() => {
  let player = null;
  let saveTimeout = null;
  let initialized = false;

  async function init(ysdk){
    if (initialized || !ysdk || !ysdk.getPlayer) return;
    try {
      player = await ysdk.getPlayer({ scopes: false });
      initialized = true;
    } catch(e){}
  }

  function save(){
    if (!player) return;
    if (saveTimeout) clearTimeout(saveTimeout);
    saveTimeout = setTimeout(async () => {
      try {
        const data = {
          records: localStorage.getItem('klondike_records_v1') || '',
          shop: localStorage.getItem('klondike_shop_v1') || '',
          hints: localStorage.getItem('klondike_hints_v1') || ''
        };
        await player.setData(data, false);
      } catch(e){}
    }, 2000);
  }

  async function load(){
    if (!player) return false;
    try {
      const data = await player.getData(['records', 'shop', 'hints']);
      if (data) {
        if (data.records) localStorage.setItem('klondike_records_v1', data.records);
        if (data.shop) localStorage.setItem('klondike_shop_v1', data.shop);
        if (data.hints) localStorage.setItem('klondike_hints_v1', data.hints);
        return true;
      }
    } catch(e){}
    return false;
  }

  return { init, save, load };
})();

