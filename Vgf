const YandexGames = (() => {
  let ysdk = null, initPromise = null, isPausedByPlatform = false, gameStartCount = 0;
  const SHOW_EVERY = 3;
  let isRewardedVideoLoading = false;

  function init(){
    if (initPromise) return initPromise;
    initPromise = (async () => {
      try {
        await loadScript('https://sdk.games.s3.yandex.net/sdk.js');
        if (typeof YaGames === 'undefined') throw new Error('no YaGames');
        ysdk = await YaGames.init();
        setupListeners();
        try {
          if (ysdk.features && ysdk.features.LoadingAPI) ysdk.features.LoadingAPI.ready();
        } catch(e){}
        return ysdk;
      } catch(err){
        ysdk = null;
        return null;
      }
    })();
    return initPromise;
  }

  function loadScript(src){
    return new Promise((resolve, reject) => {
      if (document.querySelector('script[src="' + src + '"]')) { resolve(); return; }
      const s = document.createElement('script');
      s.src = src; s.async = true;
      s.onload = () => resolve();
      s.onerror = () => reject(new Error('SDK error'));
      document.head.appendChild(s);
      setTimeout(() => reject(new Error('SDK timeout')), 6000);
    });
  }

  function setupListeners(){
    if (!ysdk || typeof ysdk.on !== 'function') return;
    try {
      ysdk.on('game_api_pause', () => {
        isPausedByPlatform = true;
        AudioManager.pauseAll();
        Game.pauseGame();
      });
      ysdk.on('game_api_resume', () => {
        isPausedByPlatform = false;
        AudioManager.resumeAll();
        Game.resumeGame();
      });
    } catch(e){}
  }

  function showFullscreenAd(){
    if (!ysdk || !ysdk.adv) return;
    AudioManager.pauseAll(); Game.pauseGame();
    let done = false;
    const finish = () => {
      if (done) return; done = true;
      if (!isPausedByPlatform) { AudioManager.resumeAll(); Game.resumeGame(); }
    };
    try {
      ysdk.adv.showFullscreenAdv({ callbacks: { onClose: finish, onError: finish } });
      setTimeout(finish, 60000);
    } catch(e){ finish(); }
  }

  function showRewardedVideo(onReward, onFinish){
    if (!ysdk || !ysdk.adv || isRewardedVideoLoading) {
      if (onFinish) onFinish();
      return;
    }
    isRewardedVideoLoading = true;
    AudioManager.pauseAll(); Game.pauseGame();
    let rewarded = false;
    let finished = false;
    const finalize = () => {
      if (finished) return; finished = true;
      isRewardedVideoLoading = false;
      if (!isPausedByPlatform) { AudioManager.resumeAll(); Game.resumeGame(); }
      if (onFinish) onFinish();
    };
    try {
      ysdk.adv.showRewardedVideo({
        callbacks: {
          onOpen: () => {},
          onRewarded: () => {
            rewarded = true;
            if (onReward) onReward();
          },
          onClose: finalize,
          onError: finalize
        }
      });
      setTimeout(() => { if (!finished && !rewarded) finalize(); }, 120000);
    } catch(e){ finalize(); }
  }

  function onGameStarted(){
    gameStartCount++;
    if (gameStartCount > 1 && gameStartCount % SHOW_EVERY === 0) {
      setTimeout(showFullscreenAd, 1500);
    }
  }

  return {
    init,
    showFullscreenAd, showRewardedVideo, onGameStarted,
    get isReady(){ return ysdk !== null; },
    get isPausedByPlatform(){ return isPausedByPlatform; }
  };
})();

