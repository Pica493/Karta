  exitGame(){ AudioManager.playClick(); try { window.close(); } catch(e){} location.reload(); },
  showWinScreen(){ const w = document.getElementById('winOverlay'); if (w) w.classList.add('active'); },
  hideWinScreen(){ const w = document.getElementById('winOverlay'); if (w) w.classList.remove('active'); },
  showDeadScreen(){ const d = document.getElementById('deadOverlay'); if (d) d.classList.add('active'); },
  hideDeadScreen(){ const d = document.getElementById('deadOverlay'); if (d) d.classList.remove('active'); },
  _hintTimer: null,
  startHintCooldownTick(){
    if (UI._hintTimer) clearInterval(UI._hintTimer);
    UI._hintTimer = setInterval(() => {
      const modal = document.getElementById('hintModal');
      if (!modal || !modal.classList.contains('active')) {
        clearInterval(UI._hintTimer); UI._hintTimer = null; return;
      }
      UI.updateHintModal();
    }, 1000);
  }
};

