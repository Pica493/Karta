      const target = getDropTarget(e.clientX, e.clientY);
      suppressNextClick = true;
      setTimeout(() => { suppressNextClick = false; }, 80);
      if (target && isGameActive) {
        if (target.type === 'foundation' && cards.length === 1) {
          tryMoveToFoundation(cards[0], source, target.index);
        } else if (target.type === 'tableau') {
          if (!(source && source.type === 'tableau' && source.col === target.index)) {
