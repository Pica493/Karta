  function findCardById(id){
    for (let i = 0; i < waste.length; i++)
      if (waste[i].id === id) return { card: waste[i], location: 'waste', index: { row: i } };
    for (let c = 0; c < 7; c++)
      for (let r = 0; r < tableau[c].length; r++)
        if (tableau[c][r].id === id) return { card: tableau[c][r], location: 'tableau', index: { col: c, row: r } };
    for (let f = 0; f < 4; f++)
      for (let i = 0; i < foundations[f].length; i++)
        if (foundations[f][i].id === id) return { card: foundations[f][i], location: 'foundation', index: { foundation: f, row: i } };
    return null;
  }
  function resolveDrag(found){
    if (!found || !found.card || !found.card.faceUp) return null;
    if (found.location === 'tableau') {
      const { col, row } = found.index;
      const pile = tableau[col];
      if (row < 0 || row >= pile.length) return null;
      for (let i = row; i < pile.length; i++) if (!pile[i].faceUp) return null;
      return { cards: pile.slice(row), source: { type: 'tableau', col, row } };
    }
    if (found.location === 'waste') {
      if (found.index.row !== waste.length - 1) return null;
      return { cards: [found.card], source: { type: 'waste' } };
    }
    return null;
  }
  function onPointerDown(e){
    if (!isGameActive) return;
    if (e.pointerType === 'mouse' && e.button !== 0) return;
    if (drag.active) return;
    const el = e.currentTarget;
    const found = findCardById(el.dataset.cardId);
    const resolved = resolveDrag(found);
    if (!resolved) return;
    e.preventDefault();
    drag.active = true; drag.started = false;
    drag.cards = resolved.cards; drag.source = resolved.source;
    drag.startX = e.clientX; drag.startY = e.clientY;
    drag.pointerId = e.pointerId; drag.ghost = null;
    document.addEventListener('pointermove', onPointerMove);
    document.addEventListener('pointerup', onPointerUp);
    document.addEventListener('pointercancel', onPointerCancel);
  }
  function onPointerMove(e){
    if (!drag.active || e.pointerId !== drag.pointerId) return;
    const dx = e.clientX - drag.startX;
    const dy = e.clientY - drag.startY;
    const dist = Math.sqrt(dx*dx + dy*dy);
    if (!drag.started && dist > 6) {
      drag.started = true;
      const topEl = document.querySelector('.card[data-card-id="' + drag.cards[0].id + '"]');
      if (topEl) {
        const rect = topEl.getBoundingClientRect();
        drag.offsetX = drag.startX - rect.left;
        drag.offsetY = drag.startY - rect.top;
