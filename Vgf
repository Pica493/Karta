const Hints = (() => {
  const KEY = 'klondike_hints_v1';
  let state = { count: FREE_HINTS_PER_DAY, lastReset: new Date().toISOString().slice(0,10), lastRewardedAdTime: 0 };
  try {
    const saved = localStorage.getItem(KEY);
    if (saved) {
      const parsed = JSON.parse(saved);
      if (parsed && typeof parsed === 'object') state = { ...state, ...parsed };
    }
  } catch(e){}
  const today = new Date().toISOString().slice(0,10);
  if (state.lastReset !== today) {
    state.count = FREE_HINTS_PER_DAY;
    state.lastReset = today;
    save();
  }
  function save(){ try { localStorage.setItem(KEY, JSON.stringify(state)); PlayerData.save(); } catch(e) {} }
  return {
    get count(){ return state.count; },
    canWatchAd(){ return (Date.now() - state.lastRewardedAdTime) >= HINT_REWARD_COOLDOWN_MS; },
    cooldownRemaining(){ return Math.max(0, HINT_REWARD_COOLDOWN_MS - (Date.now() - state.lastRewardedAdTime)); },
    spend(){
      if (state.count <= 0) return false;
      state.count--;
      save();
      updateHintButton();
      return true;
    },
    grantFromAd(){
      state.count++;
      state.lastRewardedAdTime = Date.now();
      save();
      updateHintButton();
    }
  };
})();

function updateHintButton(){
  const btn = document.getElementById('hintBtn');
  const cnt = document.getElementById('hintCount');
  if (!btn || !cnt) return;
  cnt.textContent = Hints.count;
  btn.classList.toggle('empty', Hints.count <= 0);
}

