  }
  function trackMove(cardId, fromKey, toKey){
    if (lastMove && lastMove.cardId === cardId && lastMove.fromKey === toKey && lastMove.toKey === fromKey) {
      pingPongCount++;
    } else { pingPongCount = 0; }
    lastMove = { cardId, fromKey, toKey };
    pushHash();
  }
  function pushHash(){
    const hash = computeStateHash();
    stateHashes.push(hash);
    if (stateHashes.length > MAX_HASHES) stateHashes.shift();
  }
  function resetLoopTracking(){
    lastMove = null; pingPongCount = 0; stateHashes.length = 0;
  }
  function detectInfiniteLoop(){
    if (pingPongCount >= PING_PONG_THRESHOLD) return true;
    if (stateHashes.length < 5) return false;
    const current = stateHashes[stateHashes.length - 1];
    let count = 0;
    const recent = stateHashes.slice(-10);
    for (let i = 0; i < recent.length; i++) if (recent[i] === current) count++;
    return count >= STATE_REPEAT_THRESHOLD;
  }

  function attemptAutoMove(cards, source){
    if (!cards || !cards.length || !source) return;
    const topCard = cards[0];
    if (cards.length === 1) {
      for (let f = 0; f < 4; f++) {
        if (topCard.canPlaceOnFoundation(foundations[f])) { performMoveToFoundation(topCard, source, f); return; }
      }
    }
    for (let col = 0; col < 7; col++) {
      if (source.type === 'tableau' && source.col === col) continue;
      const pile = tableau[col];
      const valid = pile.length === 0 ? topCard.rank === 'K' : topCard.canPlaceOn(pile[pile.length - 1]);
      if (valid) { performMoveToTableau(cards, source, col); return; }
    }
    AudioManager.playInvalid();
  }
  function tryMoveToTableau(cards, source, targetCol){
    if (!cards || !cards.length || !source) return;
    const topCard = cards[0];
    const pile = tableau[targetCol];
    const valid = pile.length === 0 ? topCard.rank === 'K' : topCard.canPlaceOn(pile[pile.length - 1]);
    if (!valid) { AudioManager.playInvalid(); return; }
    performMoveToTableau(cards, source, targetCol);
  }
  function performMoveToTableau(cards, source, targetCol){
    if (!isGameActive) return;
    saveState();
    removeFromSource(source);
    cards.forEach(c => { c.faceUp = true; tableau[targetCol].push(c); });
    revealNextCard(source);
    moves++;
    trackMove(cards[0].id, source.type === 'tableau' ? ('T' + source.col) : 'W', 'T' + targetCol);
    AudioManager.playMove();
    autoCollect(); render();
    if (checkWin()) return;
    checkEndConditions();
  }
  function tryMoveToFoundation(card, source, fIdx){
    if (!card || !source || !card.canPlaceOnFoundation(foundations[fIdx])) { AudioManager.playInvalid(); return; }
    performMoveToFoundation(card, source, fIdx);
  }
  function performMoveToFoundation(card, source, fIdx){
    if (!isGameActive) return;
    saveState();
    removeFromSource(source);
    card.faceUp = true;
    foundations[fIdx].push(card);
    for (let i = 0; i < foundations[fIdx].length; i++) foundations[fIdx][i].faceUp = true;
    revealNextCard(source);
    moves++;
    trackMove(card.id, source.type === 'tableau' ? ('T' + source.col) : 'W', 'F' + fIdx);
    AudioManager.playFoundation();
    autoCollect(); render();
    if (checkWin()) return;
    checkEndConditions();
  }
  function removeFromSource(source){
    if (!source) return;
    if (source.type === 'tableau') tableau[source.col].splice(source.row);
    else if (source.type === 'waste') waste.pop();
  }
  function revealNextCard(source){
    if (source && source.type === 'tableau') {
      const pile = tableau[source.col];
      if (pile.length && !pile[pile.length - 1].faceUp) {
        pile[pile.length - 1].faceUp = true;
        AudioManager.playFlip();
      }
    }
  }
  function autoCollect(){
    let collected = true;
    while (collected) {
      collected = false;
      for (let col = 0; col < 7; col++) {
        const pile = tableau[col];
        if (!pile.length) continue;
        const card = pile[pile.length - 1];
        if (!card.faceUp) continue;
        for (let f = 0; f < 4; f++) {
          if (card.canPlaceOnFoundation(foundations[f])) {
            pile.pop();
            card.faceUp = true;
            foundations[f].push(card);
            for (let i = 0; i < foundations[f].length; i++) foundations[f][i].faceUp = true;
            AudioManager.playFoundation();
            collected = true; break;
          }
        }
        if (collected) break;
      }
      if (collected) continue;
      if (waste.length) {
        const card = waste[waste.length - 1];
        for (let f = 0; f < 4; f++) {
          if (card.canPlaceOnFoundation(foundations[f])) {
            waste.pop();
            card.faceUp = true;
            foundations[f].push(card);
            for (let i = 0; i < foundations[f].length; i++) foundations[f][i].faceUp = true;
            AudioManager.playFoundation();
            collected = true; break;
          }
        }
      }
    }
  }
  function drawFromStock(){
    if (!isGameActive || isPaused || drag.active || suppressNextClick) return;
    if (stock.length === 0) {
      if (waste.length === 0) return;
      saveState();
      while (waste.length) {
        const c = waste.pop();
        c.faceUp = false;
        stock.push(c);
      }
      AudioManager.playFlip();
      moves++;
      pingPongCount = 0; lastMove = null;
      pushHash();
      autoCollect(); render();
      if (checkWin()) return;
      checkEndConditions();
      return;
    }
    saveState();
    const n = Math.min(Settings.drawMode, stock.length);
    for (let i = 0; i < n; i++) {
      const c = stock.pop();
      c.faceUp = true;
      waste.push(c);
    }
    moves++;
    pingPongCount = 0; lastMove = null;
    pushHash();
    AudioManager.playFlip();
    autoCollect(); render();
    if (checkWin()) return;
    checkEndConditions();
  }
  function saveState(){
    for (let f = 0; f < 4; f++) for (let i = 0; i < foundations[f].length; i++) foundations[f][i].faceUp = true;
    for (let i = 0; i < waste.length; i++) waste[i].faceUp = true;
    history.push({
      stock: stock.map(c => c.toJSON()),
      waste: waste.map(c => c.toJSON()),
      foundations: foundations.map(f => f.map(c => c.toJSON())),
      tableau: tableau.map(t => t.map(c => c.toJSON())),
      seconds, moves
    });
    const max = Settings.maxHistory;
    while (history.length > max) history.shift();
    updateUndoButton();
  }
  function restoreState(s){
    const parse = j => new Card(j.suit, j.rank, j.faceUp);
    stock = s.stock.map(parse);
    waste = s.waste.map(parse);
    foundations = s.foundations.map(f => f.map(parse));
    tableau = s.tableau.map(t => t.map(parse));
    for (let f = 0; f < 4; f++) for (let i = 0; i < foundations[f].length; i++) foundations[f][i].faceUp = true;
    for (let i = 0; i < waste.length; i++) waste[i].faceUp = true;
    seconds = s.seconds; moves = s.moves;
  }
  function undo(){
    if (isPaused || !history.length || drag.active) return;
    clearDeadCheck();
    clearHint();
    const wasInactive = !isGameActive;
    const deadScreenOpen = document.getElementById('deadOverlay') && document.getElementById('deadOverlay').classList.contains('active');
    restoreState(history.pop());
    AudioManager.playMove();
    lastMove = null; pingPongCount = 0;
    if (stateHashes.length > 0) stateHashes.pop();
    if (wasInactive || deadScreenOpen) {
      isGameActive = true;
      if (!timerInterval) startTimer();
      UI.hideDeadScreen();
      AudioManager.startMusic();
    }
    render();
  }
  function updateUndoButton(){
    const btn = document.getElementById('undoBtn');
    if (btn) btn.disabled = !history.length;
  }
  function checkWin(){
    if (!isGameActive) return false;
    const total = foundations.reduce((s, f) => s + f.length, 0);
    if (total === 52) {
      isGameActive = false;
      stopTimer();
      clearDeadCheck();
      clearHint();
      AudioManager.playWin();
      const wt = document.getElementById('winTime');
      const wm = document.getElementById('winMoves');
      if (wt) wt.textContent = formatTime(seconds);
      if (wm) wm.textContent = moves;
      const isNew = Records.addRecord(Settings.difficulty, seconds, moves);
      const badge = document.getElementById('newRecordWrap');
      if (badge) badge.style.display = isNew ? 'block' : 'none';
      UI.showWinScreen();
      return true;
    }
    return false;
  }
  function hasAnyUsefulMove(){
    if (stock.length > 0) return true;
    if (waste.length > 0) {
      const w = waste[waste.length - 1];
      for (let f = 0; f < 4; f++) if (w.canPlaceOnFoundation(foundations[f])) return true;
    }
    for (let col = 0; col < 7; col++) {
      const pile = tableau[col];
      if (!pile.length) continue;
      const top = pile[pile.length - 1];
      if (!top.faceUp) continue;
      for (let f = 0; f < 4; f++) if (top.canPlaceOnFoundation(foundations[f])) return true;
    }
    if (waste.length > 0) {
      const w = waste[waste.length - 1];
      for (let t = 0; t < 7; t++) {
        const tPile = tableau[t];
        if (!tPile.length) { if (w.rank === 'K') return true; }
        else if (w.canPlaceOn(tPile[tPile.length - 1])) return true;
      }
    }
    for (let col = 0; col < 7; col++) {
      const pile = tableau[col];
      if (!pile.length) continue;
      let firstFaceUp = -1;
      for (let i = 0; i < pile.length; i++) if (pile[i].faceUp) { firstFaceUp = i; break; }
      if (firstFaceUp < 0) continue;
      const moveable = pile[firstFaceUp];
      const moveableCount = pile.length - firstFaceUp;
      for (let t = 0; t < 7; t++) {
        if (t === col) continue;
        const tPile = tableau[t];
        if (!tPile.length) {
          if (moveable.rank !== 'K') continue;
          if (firstFaceUp > 0) return true;
          if (moveableCount > 1) return true;
        } else if (moveable.canPlaceOn(tPile[tPile.length - 1])) {
          return true;
        }
      }
    }
    if (waste.length > 0) {
      for (let i = 0; i < waste.length; i++) {
        const w = waste[i];
        for (let f = 0; f < 4; f++) if (w.canPlaceOnFoundation(foundations[f])) return true;
        for (let t = 0; t < 7; t++) {
          const tPile = tableau[t];
          if (!tPile.length) { if (w.rank === 'K') return true; }
          else if (w.canPlaceOn(tPile[tPile.length - 1])) return true;
        }
      }
    }
    return false;
  }
  function checkEndConditions(){
    if (!isGameActive || isPaused) return;
    clearDeadCheck();
    if (detectInfiniteLoop()) { scheduleDeadEnd(300); return; }
    if (!hasAnyUsefulMove()) { scheduleDeadEnd(400); return; }
  }
  function scheduleDeadEnd(delay){
    deadCheckTimeout = setTimeout(() => {
      deadCheckTimeout = null;
      if (!isGameActive) return;
      isGameActive = false;
      stopTimer();
      AudioManager.playLose();
      const dt = document.getElementById('deadTime');
      const dm = document.getElementById('deadMoves');
      if (dt) dt.textContent = formatTime(seconds);
      if (dm) dm.textContent = moves;
      const undoBtn = document.getElementById('deadUndoBtn');
      if (undoBtn) undoBtn.disabled = !history.length;
      UI.showDeadScreen();
    }, delay);
  }
  function clearDeadCheck(){
    if (deadCheckTimeout) { clearTimeout(deadCheckTimeout); deadCheckTimeout = null; }
  }
  function clearHint(){
    if (hintTimeout) { clearTimeout(hintTimeout); hintTimeout = null; }
    document.querySelectorAll('.hint-source, .hint-target').forEach(el => {
      el.classList.remove('hint-source', 'hint-target');
    });
  }
  function findHint(){
    if (waste.length > 0) {
      const w = waste[waste.length - 1];
      for (let f = 0; f < 4; f++) {
        if (w.canPlaceOnFoundation(foundations[f])) return { cardIds: [w.id], target: { type: 'foundation', index: f } };
      }
    }
    for (let col = 0; col < 7; col++) {
      const pile = tableau[col];
      if (pile.length < 2) continue;
      const card = pile[pile.length - 1];
      if (!card.faceUp) continue;
      if (pile[pile.length - 2].faceUp) continue;
      for (let f = 0; f < 4; f++) {
        if (card.canPlaceOnFoundation(foundations[f])) return { cardIds: [card.id], target: { type: 'foundation', index: f } };
      }
      for (let t = 0; t < 7; t++) {
        if (t === col) continue;
        const tPile = tableau[t];
        if (tPile.length === 0) {
          if (card.rank === 'K') return { cardIds: [card.id], target: { type: 'tableau', index: t } };
        } else if (card.canPlaceOn(tPile[tPile.length - 1])) {
          return { cardIds: [card.id], target: { type: 'tableau', index: t } };
        }
      }
    }
    for (let col = 0; col < 7; col++) {
      const pile = tableau[col];
      if (!pile.length) continue;
      const card = pile[pile.length - 1];
      if (!card.faceUp) continue;
      for (let f = 0; f < 4; f++) {
        if (card.canPlaceOnFoundation(foundations[f])) return { cardIds: [card.id], target: { type: 'foundation', index: f } };
      }
    }
    if (waste.length > 0) {
      const w = waste[waste.length - 1];
      for (let t = 0; t < 7; t++) {
        const tPile = tableau[t];
        if (tPile.length === 0) {
          if (w.rank === 'K') return { cardIds: [w.id], target: { type: 'tableau', index: t } };
        } else if (w.canPlaceOn(tPile[tPile.length - 1])) {
          return { cardIds: [w.id], target: { type: 'tableau', index: t } };
        }
      }
    }
    for (let col = 0; col < 7; col++) {
      const pile = tableau[col];
      if (!pile.length) continue;
      let firstFaceUp = -1;
      for (let i = 0; i < pile.length; i++) if (pile[i].faceUp) { firstFaceUp = i; break; }
      if (firstFaceUp < 0) continue;
      const top = pile[firstFaceUp];
      for (let t = 0; t < 7; t++) {
        if (t === col) continue;
        const tPile = tableau[t];
        if (tPile.length === 0) {
          if (top.rank === 'K' && (firstFaceUp > 0 || (pile.length - firstFaceUp) > 1)) {
            return { cardIds: pile.slice(firstFaceUp).map(c => c.id), target: { type: 'tableau', index: t } };
          }
        } else if (top.canPlaceOn(tPile[tPile.length - 1])) {
          return { cardIds: pile.slice(firstFaceUp).map(c => c.id), target: { type: 'tableau', index: t } };
        }
      }
    }
    return null;
  }
  function showHint(){
    if (!isGameActive || isPaused || drag.active) return;
    clearHint();
    const hint = findHint();
    if (!hint) { AudioManager.playInvalid(); return; }
    hint.cardIds.forEach(id => {
      const el = document.querySelector('.card[data-card-id="' + id + '"]');
      if (el) el.classList.add('hint-source');
    });
    if (hint.target.type === 'foundation') {
      const fSlot = document.querySelector('.foundation-slot[data-foundation="' + hint.target.index + '"]');
      if (fSlot) fSlot.classList.add('hint-target');
    } else if (hint.target.type === 'tableau') {
      const tCol = document.querySelector('.tableau-col[data-col="' + hint.target.index + '"]');
      if (tCol) {
        const lastCard = tCol.querySelector('.card:last-child');
        if (lastCard && !lastCard.classList.contains('hint-source')) lastCard.classList.add('hint-target');
        else {
          const se = tCol.querySelector('.slot-empty');
          if (se) se.classList.add('hint-target');
        }
      }
    }
    hintTimeout = setTimeout(clearHint, 2200);
  }
  function useHint(){
    if (!isGameActive || isPaused || drag.active) return;
    if (Hints.count <= 0) { UI.showHintModal(); return; }
    Hints.spend();
    AudioManager.playHint();
    showHint();
  }
  function newGame(){
    clearDeadCheck();
    clearHint();
    history = [];
    seconds = 0; moves = 0;
    isGameActive = true; isPaused = false;
    cleanupDrag();
    suppressNextClick = false;
    resetLoopTracking();
    deal();
    render();
    startTimer();
    AudioManager.startMusic();
    AudioManager.playDeal();
    const mo = document.getElementById('menuOverlay'); if (mo) mo.classList.add('hidden');
    const gr = document.getElementById('game-root'); if (gr) gr.style.display = 'flex';
    const wo = document.getElementById('winOverlay'); if (wo) wo.classList.remove('active');
    const dor = document.getElementById('deadOverlay'); if (dor) dor.classList.remove('active');
    const nr = document.getElementById('newRecordWrap'); if (nr) nr.style.display = 'none';
    updateHintButton();
    YandexGames.onGameStarted();
  }
  function pauseGame(){ isPaused = true; clearDeadCheck(); }
  function resumeGame(){ isPaused = false; }
  function rerender(){
    cleanupDrag();
    if (isGameActive) render();
  }
  function init(){
    Settings.applyToUI();
    updateHintButton();
    const stockSlot = document.getElementById('stockSlot');
    if (stockSlot) stockSlot.addEventListener('click', drawFromStock);
    const undoBtn = document.getElementById('undoBtn');
    if (undoBtn) undoBtn.addEventListener('click', undo);
    const hintBtn = document.getElementById('hintBtn');
    if (hintBtn) hintBtn.addEventListener('click', useHint);
  }
  return {
    init, newGame, drawFromStock, undo, rerender, useHint,
    pauseGame, resumeGame,
    get isActive(){ return isGameActive; }
  };
})();

