const AudioManager = (() => {
  let ctx = null, musicGain = null, sfxGain = null;
  let melodyInterval = null;
  let musicPlaying = false, paused = false;
  let currentMusicStep = 0;

  function init(){
    if (ctx) return;
    try {
      const AC = window.AudioContext || window.webkitAudioContext;
      if (!AC) return;
      ctx = new AC();
      musicGain = ctx.createGain();
      sfxGain = ctx.createGain();
      musicGain.connect(ctx.destination);
      sfxGain.connect(ctx.destination);
      musicGain.gain.value = Settings.musicVolume / 100 * 0.12;
      sfxGain.gain.value = Settings.sfxVolume / 100 * 0.3;
    } catch(e) { ctx = null; }
  }
  function ensureCtx(){
    init();
    if (ctx && ctx.state === 'suspended' && !paused) ctx.resume().catch(() => {});
  }
  const MELODY = [60, 64, 67, 72, 71, 67, 64, 67, 69, 72, 76, 72, 69, 67, 64, 62];
  const BASS = [36, 36, 43, 36, 41, 41, 43, 36];
  function midiToFreq(m){ return 440 * Math.pow(2, (m - 69) / 12); }
  function scheduleMelody(){
    if (!ctx || paused) return;
    const t = ctx.currentTime;
    const freq = midiToFreq(MELODY[currentMusicStep % MELODY.length]);
    const osc = ctx.createOscillator();
    const g = ctx.createGain();
    osc.type = 'triangle';
    osc.frequency.value = freq;
    g.gain.setValueAtTime(0.0001, t);
    g.gain.exponentialRampToValueAtTime(0.06, t + 0.02);
    g.gain.exponentialRampToValueAtTime(0.0001, t + 0.85);
    osc.connect(g); g.connect(musicGain);
    osc.start(t); osc.stop(t + 0.9);
    if (currentMusicStep % 2 === 0) {
      const bfreq = midiToFreq(BASS[Math.floor(currentMusicStep / 2) % BASS.length]);
      const bosc = ctx.createOscillator();
      const bg = ctx.createGain();
      bosc.type = 'sine';
      bosc.frequency.value = bfreq;
      bg.gain.setValueAtTime(0.0001, t);
      bg.gain.exponentialRampToValueAtTime(0.05, t + 0.04);
      bg.gain.exponentialRampToValueAtTime(0.0001, t + 1.7);
      bosc.connect(bg); bg.connect(musicGain);
      bosc.start(t); bosc.stop(t + 1.8);
    }
    currentMusicStep++;
  }
  function startMusic(){
    ensureCtx();
    if (!ctx) return;
    // ВСЕГДА очищаем предыдущий интервал — иначе музыка может дублироваться
    if (melodyInterval) { clearInterval(melodyInterval); melodyInterval = null; }
    musicPlaying = true; paused = false;
    currentMusicStep = 0;
    scheduleMelody();
    melodyInterval = setInterval(scheduleMelody, 900);
  }
  function stopMusic(){
    musicPlaying = false; paused = false;
    if (melodyInterval) { clearInterval(melodyInterval); melodyInterval = null; }
  }
  function pauseAll(){
    if (!ctx || paused) return;
    paused = true;
    try {
      if (musicGain) musicGain.gain.setValueAtTime(0, ctx.currentTime);
      if (sfxGain) sfxGain.gain.setValueAtTime(0, ctx.currentTime);
      if (ctx.state === 'running') ctx.suspend().catch(() => {});
    } catch(e){}
  }
  function resumeAll(){
    if (!ctx) return;
    paused = false;
    try {
      if (ctx.state === 'suspended') ctx.resume().catch(() => {});
      if (musicGain) musicGain.gain.setValueAtTime(Settings.musicVolume / 100 * 0.12, ctx.currentTime);
      if (sfxGain) sfxGain.gain.setValueAtTime(Settings.sfxVolume / 100 * 0.3, ctx.currentTime);
    } catch(e){}
  }
  function playTone(freq, dur, type, vol, delay){
    if (paused) return;
    ensureCtx();
    if (!ctx) return;
    try {
      const t = ctx.currentTime + (delay || 0);
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = type || 'sine';
      osc.frequency.value = freq;
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.3 * (vol || 1), t + 0.01);
      g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
      osc.connect(g); g.connect(sfxGain);
      osc.start(t); osc.stop(t + dur + 0.05);
    } catch(e){}
  }
  function playNoise(dur, vol){
    if (paused) return;
    ensureCtx();
    if (!ctx) return;
    try {
      const bufferSize = Math.max(1, Math.floor(ctx.sampleRate * dur));
      const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
      const data = buffer.getChannelData(0);
      for (let i = 0; i < bufferSize; i++) data[i] = (Math.random() * 2 - 1) * (1 - i / bufferSize);
      const src = ctx.createBufferSource();
      src.buffer = buffer;
      const g = ctx.createGain();
      g.gain.value = 0.15 * (vol || 1);
      const filter = ctx.createBiquadFilter();
      filter.type = 'highpass';
      filter.frequency.value = 2000;
      src.connect(filter); filter.connect(g); g.connect(sfxGain);
      src.start();
    } catch(e){}
  }
  return {
    init, startMusic, stopMusic, pauseAll, resumeAll,
    playFlip(){ playTone(700,0.06,'triangle',0.4); playNoise(0.05,0.4); },
    playMove(){ playTone(450,0.08,'sine',0.5); playNoise(0.04,0.3); },
    playFoundation(){ playTone(523.25,0.12,'sine',0.6); playTone(659.25,0.12,'sine',0.5,0.05); playTone(783.99,0.18,'sine',0.4,0.1); },
    playWin(){ [523.25,659.25,783.99,1046.50,1318.51].forEach((f,i) => setTimeout(() => playTone(f,0.4,'sine',0.6), i*130)); },
    playLose(){ [392,349.23,293.66,220].forEach((f,i) => setTimeout(() => playTone(f,0.5,'sine',0.5), i*180)); },
    playInvalid(){ playTone(180,0.12,'sawtooth',0.15); },
    playClick(){ playTone(1200,0.04,'sine',0.3); },
    playHint(){ playTone(880,0.1,'sine',0.5); playTone(1320,0.15,'sine',0.4,0.08); },
    playDeal(){ for (let i = 0; i < 7; i++) setTimeout(() => { playTone(600 + Math.random()*200,0.05,'triangle',0.25); playNoise(0.03,0.2); }, i*60); },
    playUnlock(){ playTone(659.25,0.15,'sine',0.6); playTone(783.99,0.15,'sine',0.5,0.1); playTone(1046.50,0.3,'sine',0.6,0.2); },
    setMusicVolume(v){ ensureCtx(); if (musicGain && !paused) musicGain.gain.value = v * 0.12; },
    setSfxVolume(v){ ensureCtx(); if (sfxGain && !paused) sfxGain.gain.value = v * 0.3; }
  };
})();

