   ================================================================ */
class Card {
  constructor(suit, rank, faceUp = false){
    this.suit = suit;
    this.rank = rank;
    this.faceUp = faceUp;
    this.id = suit + rank + Math.random().toString(36).slice(2, 7);
  }
  get color(){ return SUIT_COLORS[this.suit]; }
  get value(){ return RANK_VALUES[this.rank]; }
  canPlaceOn(other){
    if (!other || !other.faceUp) return false;
    return this.value === other.value - 1 && this.color !== other.color;
  }
  canPlaceOnFoundation(pile){
    if (!pile.length) return this.rank === 'A';
    const top = pile[pile.length - 1];
    return top.suit === this.suit && this.value === top.value + 1;
  }
  toJSON(){ return { suit: this.suit, rank: this.rank, faceUp: this.faceUp }; }
}

