<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="theme-color" content="#0b2b1e">
<title>Косынка — Klondike Solitaire</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@700;800&display=swap" rel="stylesheet">
<style>
:root{
  --felt-dark:#0b2b1e;--felt-mid:#0e3a28;--felt-light:#134d36;
  --gold:#c9a84c;--gold-light:#e8d48b;
  --card-w:80px;--card-h:112px;--radius:8px;
  --shadow-card:0 4px 12px rgba(0,0,0,.5),0 1px 3px rgba(0,0,0,.4);
  --shadow-card-hover:0 8px 24px rgba(0,0,0,.6),0 2px 6px rgba(0,0,0,.5);
  --shadow-modal:0 24px 64px rgba(0,0,0,.7);
  --tr:.25s cubic-bezier(.4,0,.2,1);
  --table-bg: radial-gradient(ellipse at 50% 0%,rgba(20,80,55,.55) 0%,transparent 70%),radial-gradient(ellipse at 50% 100%,rgba(5,20,12,.8) 0%,transparent 60%),linear-gradient(160deg,#134d36 0%,#0e3a28 40%,#0b2b1e 100%);
  --card-back-base: linear-gradient(135deg,#1e3d60 0%,#122a47 40%,#1e3d60 100%);
  --card-back-accent: rgba(201,168,76,.15);
  --card-back-pattern: repeating-linear-gradient(45deg,transparent,transparent 4px,rgba(201,168,76,.05) 4px,rgba(201,168,76,.05) 5px),repeating-linear-gradient(-45deg,transparent,transparent 4px,rgba(201,168,76,.05) 4px,rgba(201,168,76,.05) 5px);
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-touch-callout:none;-webkit-user-select:none;user-select:none}
html,body{width:100%;height:100%;overflow:hidden;font-family:'Inter',-apple-system,sans-serif;background:var(--felt-dark);color:#e8e6e1;-webkit-tap-highlight-color:transparent;overscroll-behavior:none}
#game-root{width:100%;height:100%;background:var(--table-bg);position:relative;display:flex;flex-direction:column;overflow:hidden;padding:env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left)}
#game-root::before{content:'';position:absolute;inset:0;background-image:url("data:image/svg+xml,%3Csvg width='4' height='4' xmlns='http://www.w3.org/2000/svg'%3E%3Crect width='1' height='1' fill='%23ffffff' opacity='0.015'/%3E%3C/svg%3E");pointer-events:none}
.top-bar{display:flex;align-items:center;justify-content:space-between;padding:10px 20px;z-index:10;flex-shrink:0;padding-top:calc(10px + env(safe-area-inset-top));gap:8px}
.top-bar-left,.top-bar-right{display:flex;align-items:center;gap:10px}
.stat-item{display:flex;align-items:center;gap:6px;font-size:14px;font-weight:500;color:rgba(255,255,255,.7)}
.stat-item svg{opacity:.6;flex-shrink:0}
.stat-value{color:var(--gold-light);font-weight:600;min-width:24px;text-align:center;font-variant-numeric:tabular-nums}
.icon-btn{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);color:rgba(255,255,255,.75);width:38px;height:38px;border-radius:10px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:var(--tr);font-size:16px;flex-shrink:0;padding:0;font-family:'Inter',sans-serif}
.icon-btn:hover{background:rgba(255,255,255,.12);color:#fff;border-color:rgba(255,255,255,.2);transform:translateY(-1px)}
.icon-btn:active{transform:translateY(0)}
.icon-btn:disabled{opacity:.3;cursor:not-allowed;transform:none}
.hint-btn{position:relative;width:auto;padding:0 10px;gap:6px;min-width:60px}
.hint-btn .hint-count{font-size:13px;font-weight:700;color:var(--gold-light);font-variant-numeric:tabular-nums}
.hint-btn.empty .hint-count{color:rgba(255,255,255,.35)}
.hint-btn .hint-icon{font-size:16px}
.hint-btn.empty .hint-icon{filter:grayscale(1) opacity(.6)}
.play-area{flex:1;display:flex;flex-direction:column;padding:0 20px 20px;min-height:0;z-index:1;padding-bottom:calc(20px + env(safe-area-inset-bottom));overflow:hidden;position:relative}
.top-row{display:flex;gap:14px;margin-bottom:18px;flex-shrink:0;align-items:flex-start}
.top-row-left{display:flex;gap:14px;flex:1;min-width:0}
.top-row-right{display:flex;gap:14px;flex-shrink:0}
.slot{width:var(--card-w);height:var(--card-h);border-radius:var(--radius);position:relative;transition:var(--tr);flex-shrink:0}
.slot.highlight{border-color:var(--gold) !important;background:rgba(201,168,76,.08);box-shadow:0 0 20px rgba(201,168,76,.15)}
.stock-slot{cursor:pointer;border:1.5px dashed rgba(255,255,255,.12)}
.stock-slot .card-back-mini{position:absolute;inset:0;border-radius:var(--radius);background:var(--card-back-base);border:1px solid rgba(255,255,255,.08);box-shadow:var(--shadow-card);display:flex;align-items:center;justify-content:center}
.stock-slot .card-back-mini::after{content:'';position:absolute;inset:calc(var(--card-w) * 0.1);border:1px solid var(--card-back-accent);border-radius:4px;background:var(--card-back-pattern)}
.stock-slot .stock-count{position:absolute;bottom:-16px;right:3px;font-size:calc(var(--card-w) * 0.14);color:rgba(255,255,255,.4);font-weight:500}
.stock-slot.empty .card-back-mini{display:none}
.stock-slot.empty{border-color:rgba(255,255,255,.08)}
.stock-slot.empty::after{content:'↻';position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:calc(var(--card-w) * 0.35);color:rgba(255,255,255,.15)}
.waste-slot{position:relative;background:rgba(0,0,0,.15);border-radius:var(--radius)}
.waste-slot .card{position:absolute;top:0;left:0}
.foundation-slot{position:relative;border:1.5px dashed rgba(255,255,255,.12)}
.foundation-slot .suit-watermark{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:calc(var(--card-w) * 0.4);opacity:.08;pointer-events:none}
.foundation-slot .card{position:absolute;top:0;left:0;z-index:2;pointer-events:none}
.tableau{display:flex;gap:14px;flex:1;min-height:0;align-items:flex-start}
.tableau-col{width:var(--card-w);min-height:var(--card-h);position:relative;flex-shrink:0}
.tableau-col .slot-empty{width:var(--card-w);height:var(--card-h);border-radius:var(--radius);border:1.5px dashed rgba(255,255,255,.1);transition:var(--tr)}
.tableau-col .slot-empty.highlight{border-color:var(--gold);background:rgba(201,168,76,.08);box-shadow:0 0 20px rgba(201,168,76,.15)}
.card{width:var(--card-w);height:var(--card-h);border-radius:var(--radius);position:absolute;top:0;left:0;cursor:grab;transition:box-shadow var(--tr),transform var(--tr),opacity var(--tr);will-change:transform;touch-action:none;-webkit-touch-callout:none;-webkit-user-drag:none}
.card.face-up{background:linear-gradient(145deg,#fefefe 0%,#f0ede6 100%);border:1px solid rgba(0,0,0,.12);box-shadow:var(--shadow-card);color:#1a1a1a}
.card.face-up:hover{box-shadow:var(--shadow-card-hover);z-index:100 !important}
.card.face-up.red{color:#c0392b}
.card.face-up.black{color:#1a1a1a}
.card.face-down{background:var(--card-back-base);border:1px solid rgba(255,255,255,.06);box-shadow:var(--shadow-card);cursor:default}
.card.face-down::after{content:'';position:absolute;inset:calc(var(--card-w) * 0.1);border:1px solid var(--card-back-accent);border-radius:3px;background:var(--card-back-pattern)}
.card-corner{position:absolute;display:flex;flex-direction:column;align-items:center;line-height:1;font-weight:700;z-index:4}
.card-corner.top-left{top:3.5%;left:5.5%}
.card-corner.bottom-right{bottom:3.5%;right:5.5%;transform:rotate(180deg)}
.card-corner .rank{font-size:calc(var(--card-w) * 0.19);letter-spacing:-.5px;font-family:'Playfair Display',serif}
.card-corner .suit-small{font-size:calc(var(--card-w) * 0.14);margin-top:1px}
.card-pip{position:absolute;transform:translate(-50%,-50%);font-size:calc(var(--card-w) * 0.17);line-height:1;text-align:center;pointer-events:none;z-index:2}
.card-pip-ace{left:50%;top:50%;font-size:calc(var(--card-w) * 0.55)}
.card-court{position:absolute;inset:14% 16%;display:flex;align-items:center;justify-content:center;pointer-events:none;color:inherit;z-index:2}
.card-court svg{width:100%;height:100%;display:block;color:inherit}
.card.dragging{opacity:.25;cursor:grabbing;pointer-events:none}
.card.highlight{box-shadow:0 0 20px 3px rgba(201,168,76,.85),0 0 40px 6px rgba(201,168,76,.4)}
.card.hint-source{animation:hintPulse 0.8s ease-in-out infinite;z-index:200 !important}
.card.hint-target{animation:hintTargetPulse 0.8s ease-in-out infinite;z-index:200 !important}
.slot-empty.hint-target,.foundation-slot.hint-target{border-color:var(--gold) !important;background:rgba(201,168,76,.12);box-shadow:0 0 30px rgba(201,168,76,.6);animation:hintTargetPulse 0.8s ease-in-out infinite}
@keyframes hintPulse{0%,100%{box-shadow:0 0 20px 3px rgba(201,168,76,.7),0 0 40px 6px rgba(201,168,76,.4);transform:scale(1)}50%{box-shadow:0 0 30px 8px rgba(201,168,76,1),0 0 60px 12px rgba(201,168,76,.6);transform:scale(1.05)}}
@keyframes hintTargetPulse{0%,100%{box-shadow:0 0 20px 3px rgba(201,168,76,.5)}50%{box-shadow:0 0 35px 8px rgba(201,168,76,.9)}}
#drag-ghost{position:fixed;top:0;left:0;pointer-events:none !important;z-index:999999;will-change:transform,left,top;filter:drop-shadow(0 20px 40px rgba(0,0,0,.7)) drop-shadow(0 4px 10px rgba(0,0,0,.5))}
#drag-ghost .card,#drag-ghost *{pointer-events:none !important;box-shadow:0 12px 32px rgba(0,0,0,.55) !important;cursor:grabbing}
.modal-overlay{position:fixed;inset:0;background:rgba(5,12,8,.85);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;z-index:5000;opacity:0;visibility:hidden;transition:opacity .3s ease,visibility .3s ease;padding:16px}
.modal-overlay.active{opacity:1;visibility:visible}
.modal{background:linear-gradient(160deg,#1a2a22 0%,#0f1f18 100%);border:1px solid rgba(201,168,76,.2);border-radius:20px;padding:28px 30px;max-width:520px;width:100%;max-height:88vh;overflow-y:auto;box-shadow:var(--shadow-modal);transform:translateY(20px) scale(.97);transition:transform .3s cubic-bezier(.34,1.56,.64,1);-webkit-overflow-scrolling:touch}
.modal-overlay.active .modal{transform:translateY(0) scale(1)}
.modal h2{font-family:'Playfair Display',serif;font-size:24px;color:var(--gold-light);margin-bottom:14px;letter-spacing:.5px}
.modal h3{font-size:13px;font-weight:600;color:rgba(255,255,255,.85);margin:12px 0 6px;text-transform:uppercase;letter-spacing:1px}
.modal p,.modal li{font-size:14px;line-height:1.6;color:rgba(255,255,255,.7);margin-bottom:6px}
.modal ul{padding-left:20px;margin-bottom:6px}
.modal .close-btn{margin-top:18px;width:100%;padding:12px;border-radius:12px;border:1px solid rgba(201,168,76,.3);background:rgba(201,168,76,.1);color:var(--gold-light);font-size:15px;font-weight:600;cursor:pointer;transition:var(--tr);font-family:'Inter',sans-serif}
.modal .close-btn:hover{background:rgba(201,168,76,.2);border-color:var(--gold)}
.modal .close-btn.primary{background:linear-gradient(135deg,rgba(201,168,76,.3) 0%,rgba(201,168,76,.15) 100%);border-color:rgba(201,168,76,.6)}
.modal .close-btn:disabled{opacity:.4;cursor:not-allowed}
.tabs{display:flex;gap:6px;margin-bottom:16px;background:rgba(0,0,0,.2);padding:4px;border-radius:12px}
.tab-btn{flex:1;padding:9px 12px;border-radius:8px;border:none;background:transparent;color:rgba(255,255,255,.5);font-size:13px;font-weight:600;cursor:pointer;transition:var(--tr);font-family:'Inter',sans-serif}
.tab-btn.active{background:rgba(201,168,76,.2);color:var(--gold-light)}
.tab-btn:not(.active):hover{color:rgba(255,255,255,.75)}
.record-row{display:flex;align-items:center;gap:12px;padding:10px 12px;border-radius:10px;background:rgba(255,255,255,.03);margin-bottom:6px;font-size:14px}
.record-row.top1{background:linear-gradient(90deg,rgba(201,168,76,.18) 0%,rgba(201,168,76,.05) 100%);border:1px solid rgba(201,168,76,.3)}
.record-rank{font-weight:700;font-size:16px;min-width:24px;text-align:center;font-family:'Playfair Display',serif}
.record-row.top1 .record-rank{color:#ffd700}
.record-row.top2 .record-rank{color:#c0c0c0}
.record-row.top3 .record-rank{color:#cd7f32}
.record-time{font-weight:700;color:var(--gold-light);font-variant-numeric:tabular-nums;min-width:60px}
.record-moves{color:rgba(255,255,255,.5);font-size:12px}
.record-date{color:rgba(255,255,255,.3);font-size:11px;margin-left:auto}
.record-empty{text-align:center;color:rgba(255,255,255,.35);padding:30px 20px;font-size:14px;font-style:italic}
.hint-info{margin:12px 0;padding:14px;background:rgba(201,168,76,.08);border-radius:10px;border-left:3px solid var(--gold)}
.hint-info p{margin:0;font-size:13px}
.cooldown-timer{font-weight:700;color:var(--gold-light);font-variant-numeric:tabular-nums}
.shop-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:4px}
.shop-item{position:relative;cursor:pointer;border-radius:12px;overflow:hidden;border:2px solid rgba(255,255,255,.1);background:rgba(255,255,255,.03);transition:var(--tr);padding:6px}
.shop-item:hover{border-color:rgba(201,168,76,.5);transform:translateY(-2px)}
.shop-item.selected{border-color:var(--gold);box-shadow:0 0 16px rgba(201,168,76,.5)}
.shop-item.locked{opacity:.75}
.shop-item.loading{pointer-events:none;opacity:.5}
.shop-preview{width:100%;height:80px;border-radius:8px;position:relative;overflow:hidden;box-shadow:inset 0 0 0 1px rgba(255,255,255,.08)}
.shop-preview-back{display:flex;align-items:center;justify-content:center}
.shop-preview-inner{position:absolute;inset:12%;border-radius:3px}
.shop-name{text-align:center;font-size:12px;margin-top:6px;color:rgba(255,255,255,.85);font-weight:600;line-height:1.2}
.shop-price{text-align:center;font-size:10px;color:var(--gold-light);margin-top:3px;font-weight:700;letter-spacing:.5px}
.shop-lock{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-size:32px;text-shadow:0 2px 10px rgba(0,0,0,.95);pointer-events:none;z-index:2}
.shop-active{position:absolute;top:8px;right:8px;background:var(--gold);color:#0b2b1e;width:22px;height:22px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:13px;z-index:3}
.menu-overlay{position:fixed;inset:0;background:radial-gradient(ellipse at 50% 30%,rgba(20,80,55,.4) 0%,transparent 70%),linear-gradient(160deg,var(--felt-light) 0%,var(--felt-dark) 100%);z-index:4000;display:flex;flex-direction:column;align-items:center;justify-content:center;transition:opacity .5s ease,visibility .5s ease;padding:env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left)}
.menu-overlay.hidden{opacity:0;visibility:hidden;pointer-events:none}
.menu-title{font-family:'Playfair Display',serif;font-size:clamp(38px,7vw,72px);font-weight:800;color:var(--gold-light);letter-spacing:4px;text-shadow:0 2px 20px rgba(201,168,76,.3);margin-bottom:6px;text-align:center}
.menu-subtitle{font-size:12px;letter-spacing:6px;text-transform:uppercase;color:rgba(255,255,255,.35);margin-bottom:20px;font-weight:300;text-align:center}
.menu-buttons{display:flex;flex-direction:column;gap:8px;width:260px;max-width:80vw}
.menu-btn{padding:12px 22px;border-radius:14px;border:1px solid rgba(255,255,255,.1);background:rgba(255,255,255,.04);color:rgba(255,255,255,.8);font-size:15px;font-weight:500;cursor:pointer;transition:var(--tr);font-family:'Inter',sans-serif;text-align:center;backdrop-filter:blur(4px)}
.menu-btn:hover{background:rgba(201,168,76,.12);border-color:rgba(201,168,76,.4);color:var(--gold-light);transform:translateY(-2px);box-shadow:0 8px 24px rgba(0,0,0,.3)}
.menu-btn:active{transform:translateY(0)}
.menu-btn.primary{background:linear-gradient(135deg,rgba(201,168,76,.25) 0%,rgba(201,168,76,.1) 100%);border-color:rgba(201,168,76,.5);color:var(--gold-light);font-weight:600}
.setting-row{display:flex;align-items:center;justify-content:space-between;padding:11px 0;border-bottom:1px solid rgba(255,255,255,.06);gap:10px;flex-wrap:wrap}
.setting-row:last-child{border-bottom:none}
.setting-label{font-size:14px;color:rgba(255,255,255,.75);font-weight:500}
.setting-control{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.diff-desc{font-size:11px;color:rgba(255,255,255,.4);margin-top:4px;width:100%;line-height:1.4}
input[type="range"]{-webkit-appearance:none;appearance:none;width:110px;height:4px;border-radius:2px;background:rgba(255,255,255,.15);outline:none;cursor:pointer}
input[type="range"]::-webkit-slider-thumb{-webkit-appearance:none;width:18px;height:18px;border-radius:50%;background:var(--gold);box-shadow:0 2px 8px rgba(201,168,76,.4);cursor:pointer}
input[type="range"]::-moz-range-thumb{width:18px;height:18px;border-radius:50%;background:var(--gold);border:none;cursor:pointer}
.range-value{font-size:13px;color:var(--gold-light);font-weight:600;min-width:36px;text-align:right;font-variant-numeric:tabular-nums}
.toggle-group{display:flex;border-radius:10px;overflow:hidden;border:1px solid rgba(255,255,255,.12)}
.toggle-btn{padding:7px 12px;font-size:13px;font-weight:500;background:transparent;color:rgba(255,255,255,.5);border:none;cursor:pointer;transition:var(--tr);font-family:'Inter',sans-serif}
.toggle-btn.active{background:rgba(201,168,76,.2);color:var(--gold-light)}
.toggle-btn:not(.active):hover{background:rgba(255,255,255,.05);color:rgba(255,255,255,.7)}
.toggle-btn:disabled{opacity:.35;cursor:not-allowed}
.win-overlay,.dead-overlay{position:fixed;inset:0;background:rgba(5,12,8,.9);backdrop-filter:blur(12px);display:flex;align-items:center;justify-content:center;z-index:6000;opacity:0;visibility:hidden;transition:opacity .4s ease,visibility .4s ease;padding:20px}
.win-overlay.active,.dead-overlay.active{opacity:1;visibility:visible}
.win-content{text-align:center;transform:scale(.9);transition:transform .4s cubic-bezier(.34,1.56,.64,1);padding:0 20px;max-width:480px;width:100%}
.win-overlay.active .win-content,.dead-overlay.active .win-content{transform:scale(1)}
.win-icon{font-size:56px;margin-bottom:12px;display:block;animation:pulse 1.5s ease-in-out infinite}
.dead-overlay .win-icon{animation:none}
@keyframes pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.1)}}
.win-content h2{font-family:'Playfair Display',serif;font-size:34px;color:var(--gold-light);margin-bottom:8px}
.win-content p{font-size:15px;color:rgba(255,255,255,.6);margin-bottom:22px;line-height:1.5}
.win-stats{display:flex;gap:32px;justify-content:center;margin-bottom:22px}
.win-stat{text-align:center}
.win-stat .value{font-size:26px;font-weight:700;color:var(--gold-light);font-variant-numeric:tabular-nums}
.win-stat .label{font-size:11px;text-transform:uppercase;letter-spacing:1px;color:rgba(255,255,255,.4);margin-top:4px}
.new-record-badge{display:inline-block;padding:6px 14px;background:linear-gradient(135deg,#c9a84c,#e8d48b);color:#0b2b1e;border-radius:20px;font-weight:700;font-size:12px;letter-spacing:1px;text-transform:uppercase;margin-bottom:12px;animation:pulse 1.5s ease-in-out infinite}
@media (orientation: landscape){:root{--card-h:min(112px,14vh);--card-w:calc(var(--card-h) / 1.4)}}
@media (orientation: portrait){:root{--card-w:min(11.5vw,11.5vh,110px);--card-h:calc(var(--card-w) * 1.4)}}
@media (orientation: landscape) and (min-width:1400px) and (min-height:800px){:root{--card-h:min(140px,16vh)}}
@media (orientation: landscape) and (min-width:2000px) and (min-height:1000px){:root{--card-h:min(182px,18vh)}}
@media (orientation: portrait) and (min-width:700px){:root{--card-w:min(10vw,10vh,130px)}}
@media (orientation: landscape) and (max-height:500px){
  .top-bar{padding:3px 10px;padding-top:calc(3px + env(safe-area-inset-top))}
  .stat-item{font-size:11px}
  .icon-btn{width:30px;height:30px;font-size:13px}
  .hint-btn{min-width:48px;padding:0 8px}
  .hint-btn .hint-count{font-size:11px}
  .play-area{padding:0 8px 4px;padding-bottom:calc(4px + env(safe-area-inset-bottom))}
  .top-row{gap:6px;margin-bottom:8px}
  .top-row-left,.top-row-right{gap:6px}
  .tableau{gap:6px}
}
@media (orientation: portrait) and (max-width:500px){
  .top-bar{padding:6px 10px;padding-top:calc(6px + env(safe-area-inset-top));gap:6px}
  .top-bar-left,.top-bar-right{gap:5px}
  .stat-item{font-size:10px;gap:3px}
  .stat-item svg{width:11px;height:11px}
  .icon-btn{width:30px;height:30px;font-size:13px;border-radius:8px}
  .hint-btn{min-width:42px;padding:0 6px;gap:3px}
  .hint-btn .hint-icon{font-size:13px}
