    if (drag.ghost) { drag.ghost.remove(); drag.ghost = null; }
    drag.cards.forEach(c => {
      const cEl = document.querySelector('.card[data-card-id="' + c.id + '"]');
      if (cEl) cEl.classList.remove('dragging');
    });
    document.querySelectorAll('.highlight').forEach(el => el.classList.remove('highlight'));
    drag.active = false; drag.started = false;
    drag.cards = []; drag.source = null;
    drag.pointerId = null;
    document.body.style.cursor = '';
  }
  function buildGhost(cards){
    const ghost = document.createElement('div');
    ghost.id = 'drag-ghost';
    const firstEl = document.querySelector('.card[data-card-id="' + cards[0].id + '"]');
    if (!firstEl) return ghost;
    const rect = firstEl.getBoundingClientRect();
    const w = rect.width, h = rect.height;
    const ov = getOverlaps();
    cards.forEach((card, i) => {
      const src = document.querySelector('.card[data-card-id="' + card.id + '"]');
      if (!src) return;
      const clone = src.cloneNode(true);
      clone.classList.remove('dragging', 'highlight');
      clone.style.position = 'absolute';
      clone.style.top = (i * ov.up) + 'px';
      clone.style.left = '0';
      clone.style.width = w + 'px';
      clone.style.height = h + 'px';
      clone.style.pointerEvents = 'none';
      clone.style.transition = 'none';
      ghost.appendChild(clone);
