const Records = (() => {
  const KEY = 'klondike_records_v1';
  let data = { easy: [], standard: [], hard: [] };
  try {
    const saved = localStorage.getItem(KEY);
    if (saved) {
      const parsed = JSON.parse(saved);
      if (parsed && typeof parsed === 'object') {
        data = {
          easy: Array.isArray(parsed.easy) ? parsed.easy : [],
          standard: Array.isArray(parsed.standard) ? parsed.standard : [],
          hard: Array.isArray(parsed.hard) ? parsed.hard : []
        };
      }
    }
  } catch(e) {}
  function save(){ try { localStorage.setItem(KEY, JSON.stringify(data)); PlayerData.save(); } catch(e) {} }
  return {
    getTop(d){ return (data[d] || []).slice(); },
    addRecord(d, timeSec, movesCount){
      if (!data[d]) data[d] = [];
      const rec = { time: timeSec, moves: movesCount, date: new Date().toISOString().slice(0,10) };
      const arr = data[d];
      arr.push(rec);
      arr.sort((a, b) => a.time - b.time);
      data[d] = arr.slice(0, MAX_RECORDS_PER_DIFFICULTY);
      save();
      return data[d].indexOf(rec) >= 0;
    }
  };
})();

