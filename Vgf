    const isBg = this.currentTab === 'bg';
    const items = isBg ? Shop.backgrounds : Shop.cardBacks;
    const activeId = isBg ? Shop.getActiveBg() : Shop.getActiveBack();
    let html = '';
    items.forEach(item => {
      const unlocked = isBg ? Shop.isBgUnlocked(item.id) : Shop.isBackUnlocked(item.id);
      const isActive = activeId === item.id;
      let preview;
      if (isBg) {
        preview = '<div class="shop-preview" style="background:' + item.bg + '"></div>';
      } else {
        preview = '<div class="shop-preview shop-preview-back" style="background:' + item.base + '">' +
                  '<div class="shop-preview-inner" style="background:' + item.pattern + ';border:1px solid ' + item.accent + '"></div>' +
                  '</div>';
      }
      const cls = 'shop-item' + (isActive ? ' selected' : '') + (unlocked ? '' : ' locked');
      html += '<div class="' + cls + '" data-id="' + item.id + '">' +
              preview +
              '<div class="shop-name">' + item.name + '</div>' +
              (!unlocked ? '<div class="shop-price">▶ Реклама</div>' : '') +
              (!unlocked ? '<div class="shop-lock">🔒</div>' : '') +
              (isActive ? '<div class="shop-active">✓</div>' : '') +
              '</div>';
    });
    grid.innerHTML = html;
    grid.querySelectorAll('.shop-item').forEach(el => {
      el.addEventListener('click', () => this.onItemClick(el.dataset.id));
    });
  },
  onItemClick(id){
    const isBg = this.currentTab === 'bg';
    const unlocked = isBg ? Shop.isBgUnlocked(id) : Shop.isBackUnlocked(id);
    if (unlocked) {
      AudioManager.playClick();
      if (isBg) Shop.selectBg(id); else Shop.selectBack(id);
      this.render();
      return;
    }
    AudioManager.playClick();
    const item = (isBg ? Shop.backgrounds : Shop.cardBacks).find(x => x.id === id);
    if (!item) return;
    const el = document.querySelector('.shop-item[data-id="' + id + '"]');
    if (el) el.classList.add('loading');
    YandexGames.showRewardedVideo(
      () => {
        if (isBg) Shop.unlockBg(id); else Shop.unlockBack(id);
        AudioManager.playUnlock();
        if (el) el.classList.remove('loading');
        this.render();
      },
      () => {
        if (el) el.classList.remove('loading');
      }
    );
  }
};

function watchAdForHint(){
  const btn = document.getElementById('hintWatchAdBtn');
  if (!btn || btn.disabled) return;
  if (!Hints.canWatchAd()) return;
  btn.disabled = true;
  btn.textContent = '⏳ Загрузка...';
  YandexGames.showRewardedVideo(
    () => {
      Hints.grantFromAd();
      UI.updateHintModal();
      AudioManager.playHint();
    },
    () => {
      UI.updateHintModal();
      UI.startHintCooldownTick();
    }
  );
}

/* ================================================================
   ЗАПУСК
   ================================================================ */
document.addEventListener('DOMContentLoaded', () => {
  Shop.apply();
  Game.init();

  // Кнопки меню
  document.querySelectorAll('.menu-overlay .menu-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const action = btn.dataset.action;
      if (action === 'new-game') { AudioManager.playClick(); Game.newGame(); }
      else if (action === 'rules') UI.showRules();
      else if (action === 'settings') UI.showSettings();
      else if (action === 'records') UI.showRecords();
      else if (action === 'shop') UI.showShop();
      else if (action === 'exit') UI.exitGame();
    });
  });
  document.querySelectorAll('.win-overlay .menu-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const action = btn.dataset.action;
      if (action === 'new-game') { AudioManager.playClick(); UI.hideWinScreen(); Game.newGame(); }
      else if (action === 'records') UI.showRecords(Settings.difficulty);
      else if (action === 'go-menu') { UI.hideWinScreen(); UI.goToMenu(); }
    });
  });
  document.querySelectorAll('.dead-overlay .menu-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const action = btn.dataset.action;
      if (action === 'new-game') { AudioManager.playClick(); UI.hideDeadScreen(); Game.newGame(); }
      else if (action === 'undo') { AudioManager.playClick(); Game.undo(); }
      else if (action === 'go-menu') { UI.hideDeadScreen(); UI.goToMenu(); }
    });
  });

  document.getElementById('settingsBtn').addEventListener('click', UI.showSettings);
  document.getElementById('menuBtn').addEventListener('click', UI.goToMenu);

  document.querySelectorAll('.close-btn[data-close]').forEach(btn => {
    btn.addEventListener('click', () => UI.closeModal(btn.dataset.close));
  });
  document.querySelectorAll('.modal-overlay').forEach(o => {
    o.addEventListener('pointerdown', e => {
      if (e.target === o) {
        o.classList.remove('active');
        if (o.id === 'hintModal' && UI._hintTimer) { clearInterval(UI._hintTimer); UI._hintTimer = null; }
      }
    });
  });

  const mv = document.getElementById('musicVolume');
  if (mv) mv.addEventListener('input', e => Settings.setMusicVolume(e.target.value));
  const sv = document.getElementById('sfxVolume');
  if (sv) sv.addEventListener('input', e => Settings.setSfxVolume(e.target.value));
  document.querySelectorAll('#drawModeToggle .toggle-btn').forEach(b => {
    b.addEventListener('click', () => Settings.setDrawMode(parseInt(b.dataset.mode)));
  });
  document.querySelectorAll('#difficultyToggle .toggle-btn').forEach(b => {
    b.addEventListener('click', () => Settings.setDifficulty(b.dataset.diff));
  });

  document.querySelectorAll('#recordsTabs .tab-btn').forEach(b => {
    b.addEventListener('click', () => { AudioManager.playClick(); RecordsUI.render(b.dataset.diff); });
  });
  document.querySelectorAll('#shopTabs .tab-btn').forEach(b => {
    b.addEventListener('click', () => { AudioManager.playClick(); ShopUI.render(b.dataset.tab); });
  });

  const adBtn = document.getElementById('hintWatchAdBtn');
  if (adBtn) adBtn.addEventListener('click', watchAdForHint);

  // Горячие клавиши
  document.addEventListener('keydown', e => {
    const modalActive = document.querySelector('.modal-overlay.active');
    const overlayActive = document.querySelector('.win-overlay.active, .dead-overlay.active');
    if (e.key === 'Escape') { if (modalActive) modalActive.classList.remove('active'); }
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'z') {
      if (modalActive) return;
      e.preventDefault();
      Game.undo();
    }
    if (e.key === ' ' || e.key === 'Spacebar') {
      const menuHidden = document.getElementById('menuOverlay').classList.contains('hidden');
      if (!modalActive && !overlayActive && menuHidden) { e.preventDefault(); Game.drawFromStock(); }
    }
    if ((e.key === 'h' || e.key === 'H' || e.key === 'р' || e.key === 'Р') && !modalActive) {
      e.preventDefault();
      Game.useHint();
    }
  });

  // Защита
  document.addEventListener('contextmenu', e => e.preventDefault());

  // Обработка смены ориентации
  let resizeTimer = null;
  let lastW = window.innerWidth, lastH = window.innerHeight;
  function onViewportChange(){
    const w = window.innerWidth, h = window.innerHeight;
    if (Math.abs(w - lastW) < 5 && Math.abs(h - lastH) < 5) return;
    lastW = w; lastH = h;
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      try { if (Game.isActive) Game.rerender(); } catch(e){}
    }, 120);
  }
  window.addEventListener('resize', onViewportChange, { passive: true });
  window.addEventListener('orientationchange', () => {
    lastW = 0; lastH = 0; // Сброс порогов, чтобы следующий resize гарантированно обработался
    setTimeout(onViewportChange, 250);
    setTimeout(() => { if (Game.isActive) Game.rerender(); }, 500);
  });
  if (screen.orientation && screen.orientation.addEventListener) {
    screen.orientation.addEventListener('change', () => {
      lastW = 0; lastH = 0;
      setTimeout(onViewportChange, 250);
    });
  }

  // Потеря фокуса
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      AudioManager.pauseAll();
      Game.pauseGame();
    } else if (!YandexGames.isPausedByPlatform) {
      AudioManager.resumeAll();
      Game.resumeGame();
    }
  });
  window.addEventListener('blur', () => {
    AudioManager.pauseAll();
    Game.pauseGame();
  });
  window.addEventListener('focus', () => {
    if (!YandexGames.isPausedByPlatform) {
      AudioManager.resumeAll();
      Game.resumeGame();
    }
  });

  // SDK в фоне — не блокирует игру
  YandexGames.init().then(ysdk => {
    if (!ysdk) return;
    PlayerData.init(ysdk).then(() => {
      PlayerData.load().then(() => {
        Shop.apply();
      });
    });
  });
});
</script>
</body>
</html>
