      const colEl = target.element;
      const cards = colEl.querySelectorAll('.card');
      let last = null;
      for (let i = cards.length - 1; i >= 0; i--) {
        if (!cards[i].classList.contains('dragging')) { last = cards[i]; break; }
      }
      if (last) last.classList.add('highlight');
      else {
        const se = colEl.querySelector('.slot-empty');
        if (se) se.classList.add('highlight');
      }
    }
  }
  function getDropTarget(x, y){
    const el = document.elementFromPoint(x, y);
    if (!el) return null;
    const fSlot = el.closest('.foundation-slot');
    if (fSlot) return { type: 'foundation', element: fSlot, index: parseInt(fSlot.dataset.foundation) };
    const tCol = el.closest('.tableau-col');
    if (tCol) return { type: 'tableau', element: tCol, index: parseInt(tCol.dataset.col) };
    return null;
  }

  function computeStateHash(){
    const parts = [];
    for (let c = 0; c < 7; c++) {
      const pile = tableau[c];
      let hidden = 0;
      for (let i = 0; i < pile.length; i++) if (!pile[i].faceUp) hidden++;
      const faceUpIds = pile.filter(x => x.faceUp).map(x => x.rank + x.suit).join(',');
      parts.push('T' + c + ':' + hidden + '|' + faceUpIds);
    }
    for (let f = 0; f < 4; f++) {
      const pile = foundations[f];
      parts.push('F' + f + ':' + (pile.length > 0 ? pile[pile.length - 1].rank + pile[pile.length - 1].suit : ''));
    }
