const Settings = (() => {
  const KEY = 'klondike_settings_v14';
  const defaults = { musicVolume:30, sfxVolume:60, drawMode:1, difficulty:'standard' };
  let current = { ...defaults };
  try {
    const saved = localStorage.getItem(KEY);
    if (saved) current = { ...defaults, ...JSON.parse(saved) };
  } catch(e) {}
  function save(){ try { localStorage.setItem(KEY, JSON.stringify(current)); } catch(e) {} }
  function updateDifficultyUI(){
    const d = DIFFICULTIES[current.difficulty] || DIFFICULTIES.standard;
    const hint = document.getElementById('difficultyHint');
    if (hint) hint.textContent = d.hint;
    const drawBtns = document.querySelectorAll('#drawModeToggle .toggle-btn');
    const drawHint = document.getElementById('drawModeHint');
    if (d.forceDrawMode !== null) {
      current.drawMode = d.forceDrawMode;
      drawBtns.forEach(b => {
        b.classList.toggle('active', parseInt(b.dataset.mode) === d.forceDrawMode);
        b.disabled = true;
      });
      if (drawHint) drawHint.textContent = 'Заблокировано уровнем сложности';
    } else {
      drawBtns.forEach(b => {
        b.classList.toggle('active', parseInt(b.dataset.mode) === current.drawMode);
        b.disabled = false;
      });
      if (drawHint) drawHint.textContent = 'Свободный выбор';
    }
    const disp = document.getElementById('difficultyDisplay');
    if (disp) disp.textContent = d.shortLabel;
  }
  return {
    get musicVolume(){ return current.musicVolume; },
    get sfxVolume(){ return current.sfxVolume; },
    get drawMode(){ return current.drawMode; },
    get difficulty(){ return current.difficulty; },
    get maxHistory(){ return (DIFFICULTIES[current.difficulty] || DIFFICULTIES.standard).maxHistory; },
    setMusicVolume(v){
      current.musicVolume = Math.max(0, Math.min(100, parseInt(v) || 0));
      const el = document.getElementById('musicVolumeVal');
      if (el) el.textContent = current.musicVolume + '%';
      save();
      AudioManager.setMusicVolume(current.musicVolume / 100);
    },
    setSfxVolume(v){
      current.sfxVolume = Math.max(0, Math.min(100, parseInt(v) || 0));
      const el = document.getElementById('sfxVolumeVal');
      if (el) el.textContent = current.sfxVolume + '%';
      save();
      AudioManager.setSfxVolume(current.sfxVolume / 100);
    },
    setDrawMode(mode){
      if (mode !== 1 && mode !== 3) return;
      const d = DIFFICULTIES[current.difficulty] || DIFFICULTIES.standard;
      if (d.forceDrawMode !== null) return;
      current.drawMode = mode;
      document.querySelectorAll('#drawModeToggle .toggle-btn').forEach(b => {
        b.classList.toggle('active', parseInt(b.dataset.mode) === mode);
      });
      save();
      AudioManager.playClick();
    },
    setDifficulty(diff){
      if (!DIFFICULTIES[diff]) return;
      current.difficulty = diff;
      document.querySelectorAll('#difficultyToggle .toggle-btn').forEach(b => {
        b.classList.toggle('active', b.dataset.diff === diff);
      });
      updateDifficultyUI();
      save();
      AudioManager.playClick();
    },
    applyToUI(){
      const mv = document.getElementById('musicVolume'); if (mv) mv.value = current.musicVolume;
      const mvv = document.getElementById('musicVolumeVal'); if (mvv) mvv.textContent = current.musicVolume + '%';
      const sv = document.getElementById('sfxVolume'); if (sv) sv.value = current.sfxVolume;
      const svv = document.getElementById('sfxVolumeVal'); if (svv) svv.textContent = current.sfxVolume + '%';
      document.querySelectorAll('#difficultyToggle .toggle-btn').forEach(b => {
        b.classList.toggle('active', b.dataset.diff === current.difficulty);
      });
      updateDifficultyUI();
    }
  };
})();

