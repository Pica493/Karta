const Shop = (() => {
  const KEY = 'klondike_shop_v1';
  let state = { unlockedBg: ['classic'], unlockedBack: ['classic'], activeBg: 'classic', activeBack: 'classic' };
  try {
    const saved = localStorage.getItem(KEY);
    if (saved) {
      const parsed = JSON.parse(saved);
      if (parsed && typeof parsed === 'object') state = { ...state, ...parsed };
    }
  } catch(e){}
  if (!Array.isArray(state.unlockedBg) || !state.unlockedBg.length) state.unlockedBg = ['classic'];
  if (!Array.isArray(state.unlockedBack) || !state.unlockedBack.length) state.unlockedBack = ['classic'];
  if (!state.unlockedBg.includes('classic')) state.unlockedBg.unshift('classic');
  if (!state.unlockedBack.includes('classic')) state.unlockedBack.unshift('classic');
  if (!state.unlockedBg.includes(state.activeBg)) state.activeBg = 'classic';
  if (!state.unlockedBack.includes(state.activeBack)) state.activeBack = 'classic';

  function save(){ try { localStorage.setItem(KEY, JSON.stringify(state)); if (typeof PlayerData !== 'undefined') PlayerData.save(); } catch(e){} }

  function apply(){
    const bg = BACKGROUNDS.find(b => b.id === state.activeBg) || BACKGROUNDS[0];
    const back = CARD_BACKS.find(b => b.id === state.activeBack) || CARD_BACKS[0];
    document.documentElement.style.setProperty('--table-bg', bg.bg);
    document.documentElement.style.setProperty('--card-back-base', back.base);
    document.documentElement.style.setProperty('--card-back-accent', back.accent);
    document.documentElement.style.setProperty('--card-back-pattern', back.pattern);
  }

  return {
    get state(){ return state; },
    backgrounds: BACKGROUNDS,
    cardBacks: CARD_BACKS,
    isBgUnlocked(id){ return state.unlockedBg.includes(id); },
    isBackUnlocked(id){ return state.unlockedBack.includes(id); },
    getActiveBg(){ return state.activeBg; },
    getActiveBack(){ return state.activeBack; },
    selectBg(id){ if (!this.isBgUnlocked(id)) return false; state.activeBg = id; save(); apply(); return true; },
    selectBack(id){ if (!this.isBackUnlocked(id)) return false; state.activeBack = id; save(); apply(); return true; },
    unlockBg(id){ if (!state.unlockedBg.includes(id)) state.unlockedBg.push(id); state.activeBg = id; save(); apply(); },
    unlockBack(id){ if (!state.unlockedBack.includes(id)) state.unlockedBack.push(id); state.activeBack = id; save(); apply(); },
    apply
  };
})();

